# Required
DISCORD_TOKEN=your-discord-bot-token

# Optional: Override the BubbleBuddy data directory.
# Defaults per platform:
#   macOS:  ~/Library/Application Support/BubbleBuddy
#   Windows: %APPDATA%/BubbleBuddy (fallback: ~/AppData/Roaming/BubbleBuddy)
#   Linux:   $XDG_DATA_HOME/bubblebuddy (fallback: ~/.local/share/bubblebuddy)
# BUBBLEBUDDY_HOME=/path/to/data

# Optional: Minimum log level. Only messages at or above this level are
# emitted, so lower levels are more verbose and higher levels are quieter.
# From most to least verbose:
# - All:   allow every message
# - Trace: very detailed trace information
# - Debug: debug information useful during development
# - Info:  informational messages about normal operation (default)
# - Warn:  warning conditions that may indicate problems
# - Error: error conditions that should be investigated
# - Fatal: system is unusable, immediate attention required
# - None:  suppress all messages
# Values are case-sensitive and must match exactly (default: Info).
# MINIMUM_LOG_LEVEL=Info

# Set to false and configure options below for observability
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_SERVICE_NAME=bubblebuddy
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
OTEL_BSP_SCHEDULE_DELAY=1000
OTEL_METRIC_EXPORT_INTERVAL=2000
